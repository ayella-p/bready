<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvEqName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1B3A6D"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEqDeposit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvEqName"
            android:layout_marginTop="4dp"
            android:textColor="#5C6B89"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvEqAvailable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvEqDeposit"
            android:layout_marginTop="12dp"
            android:textColor="#A0AEC0"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/badgeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/edittext_border"
            android:backgroundTint="#E8F5E9"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Available"
            android:textColor="#4CAF50"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReserve"
            android:layout_width="100dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/badgeStatus"
            android:layout_marginTop="12dp"
            app:backgroundTint="#FF7043"
            android:text="Reserve"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            app:cornerRadius="8dp" />
    </RelativeLayout>
</androidx.cardview.widget.CardView>