<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvInvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1B3A6D"
                android:textSize="16sp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/badgeBg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <TextView
                    android:id="@+id/tvBadgeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textSize="10sp" />
            </androidx.cardview.widget.CardView>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvInvQty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1B3A6D"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/tvInvUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#A0AEC0"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutDefault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInitAdd"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:backgroundTint="#1B3A6D"
                android:text="+ Add Stock"
                android:textAllCaps="false"
                app:cornerRadius="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInitDeduct"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:backgroundTint="#FF7043"
                android:text="- Deduct Stock"
                android:textAllCaps="false"
                app:cornerRadius="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutEditing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etQuantity"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="@drawable/edittext_border"
                android:hint="Enter quantity"
                android:inputType="number"
                android:paddingHorizontal="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmAdd"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    app:backgroundTint="#009688"
                    android:text="Add Stock"
                    android:textAllCaps="false"
                    app:cornerRadius="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmDeduct"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="6dp"
                    app:backgroundTint="#E53935"
                    android:text="Deduct Stock"
                    android:textAllCaps="false"
                    app:cornerRadius="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    app:backgroundTint="#E2E8F0"
                    android:text="Cancel"
                    android:textColor="#5C6B89"
                    android:textAllCaps="false"
                    app:cornerRadius="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>